# Supabase project (Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Hanya dipakai script db:setup / db:admin (Supabase -> Connect -> Pooler)
# Contoh: postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# String acak minimal 32 karakter. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# URL aplikasi (lokal atau domain Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kontak admin yang tampil di halaman Bantuan (opsional; fallback ke akun admin di database)
ADMIN_WHATSAPP=
ADMIN_EMAIL=

# Hanya diisi saat menjalankan `pnpm db:admin` untuk membuat akun admin pertama.
# Password minimal 8 karakter. Jangan commit nilai aslinya.
ADMIN_NIM=
ADMIN_NAMA=
ADMIN_PASSWORD=
